# ═══════════════════════════════════════════════════════════════════════════════
# ALPR - configuration « cloud » : MLflow sur Hugging Face, stockage sur AWS S3
# Copier vers docker/.env (non versionné) puis compléter. Ne jamais commiter .env.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Base de l'application (PostgreSQL local de la stack) ─────────────────────
DATABASE_URL=postgresql://alpr:alpr_secret@postgres:5432/alpr

# ─── Registre de modèles : MLflow (Hugging Face Space) ────────────────────────
MLFLOW_TRACKING_URI=https://<utilisateur>-<space>.hf.space
MLFLOW_EXPERIMENT=alpr-brand-classifier
MLFLOW_BRAND_MODEL=vehicle_brand_model
# registry = l'application sert le « champion » du registre (repli : fichier local)
MODEL_BRAND_SOURCE=registry
# Space privé : jeton Hugging Face en lecture, envoyé par MLflow en « Bearer »
# MLFLOW_TRACKING_TOKEN=hf_xxxxxxxxxxxxxxxx

# ─── Stockage des images : AWS S3 ─────────────────────────────────────────────
STORAGE_MODE=s3
# Vide = AWS S3 standard (sinon, adresse d'un S3 compatible : MinIO, Scaleway...)
S3_ENDPOINT=
S3_REGION=eu-west-3
S3_BUCKET_CAPTURES=<bucket-des-captures>
S3_BUCKET_DATASET=<bucket-du-jeu-de-donnees>
S3_BUCKET_ARTIFACTS=<bucket-des-artefacts-mlflow>
S3_ACCESS_KEY=<cle-aws>
S3_SECRET_KEY=<secret-aws>

# ─── Identifiants AWS lus par MLflow (artefacts envoyés directement sur S3) ───
AWS_ACCESS_KEY_ID=<cle-aws>
AWS_SECRET_ACCESS_KEY=<secret-aws>
AWS_DEFAULT_REGION=eu-west-3
